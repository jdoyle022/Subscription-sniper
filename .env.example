# Copy to .env and fill in. Setup.sh generates this file for you with random secrets.
PORT=3000
NODE_ENV=production

# 64+ random hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# How long admin tokens stay valid (jsonwebtoken format, e.g. 12h, 1d).
JWT_EXPIRES_IN=12h

# At least 16 characters. The server refuses to start with a short or default password.
ADMIN_PASSWORD=

# Exactly 64 hex characters (32 bytes) for AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

REDIS_URL=redis://localhost:6379

# Comma-separated list of browser origins allowed to call the API.
# Leave empty to block all cross-origin browser requests.
CORS_ORIGIN=

# Set to 1 (number of proxy hops) when running behind nginx or another reverse proxy.
TRUST_PROXY=

# Optional path to a Chromium binary. Leave empty to use the one Playwright installs.
CHROMIUM_PATH=
