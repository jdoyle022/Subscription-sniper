# Copy to .env and fill in.   cp .env.example .env
# Generate tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- Web desk ----
PORT=8787
# Keep 127.0.0.1 unless you put the app behind HTTPS + a reverse proxy.
HOST=127.0.0.1
# Your login for the web desk (24+ characters).
ADMIN_TOKEN=
# Public HTTPS URL, only needed for ChatGPT Custom GPT Actions (goes into /openapi.json).
PUBLIC_URL=

# ---- Alpaca (https://app.alpaca.markets -> API keys) ----
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# paper (default) or live. Paper and live accounts have DIFFERENT keys.
TRADING_MODE=paper
# Live mode refuses to start unless this is exactly: I accept live trading risk
LIVE_TRADING_CONFIRM=
# iex (free) or sip (paid subscription)
ALPACA_DATA_FEED=iex
# indicative (free, delayed/indicative) or opra (paid real-time options data)
ALPACA_OPTIONS_FEED=indicative

# ---- Alpaca Connect (optional OAuth sign-in instead of API keys) ----
# Register an OAuth app in the Alpaca dashboard; set its redirect URI to the value below
# (default: http://127.0.0.1:8787/oauth/callback, or PUBLIC_URL + /oauth/callback).
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
ALPACA_OAUTH_REDIRECT_URI=

# ---- Risk guard (applies to every order: yours and approved AI proposals) ----
MAX_ORDER_NOTIONAL=1000
MAX_POSITION_PCT=20
MAX_DAILY_ORDERS=50
ALLOW_SHORT=false
# Options trading on this desk (your Alpaca account also needs an options approval level).
OPTIONS_ENABLED=true
# Naked short options (not covered by shares, cash, or a long leg). Off unless you mean it.
ALLOW_SHORT_OPTIONS=false
# Comma-separated. Empty allowlist = any symbol.
SYMBOL_ALLOWLIST=
SYMBOL_DENYLIST=

# ---- AI seats (leave a key empty to leave that seat empty) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

XAI_API_KEY=
XAI_MODEL=grok-4

# Proposals not decided within this many minutes expire.
PROPOSAL_TTL_MINUTES=60
AI_MAX_TOOL_ITERATIONS=8
# Paper only: execute AI proposals without waiting for you. Ignored in live mode.
AI_PAPER_AUTO_EXECUTE=false

# ---- External agents (MCP clients, ChatGPT Actions, Grok bots, your scripts) ----
# name:token pairs, comma-separated. Each token can read data and propose orders as that name.
AGENT_TOKENS=
